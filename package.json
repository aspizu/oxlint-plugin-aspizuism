{
  "name": "oxlint-plugin-aspizuism",
  "version": "1.0.5",
  "bugs": "https://github.com/aspizu/oxlint-plugin-aspizuism/issues",
  "license": "MIT",
  "author": {
    "name": "Priyanshu Dangare",
    "email": "hello@aspiz.uk",
    "url": "https://aspiz.uk/"
  },
  "repository": "https://github.com/aspizu/oxlint-plugin-aspizuism",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "build": "esbuild --bundle --format=esm --packages=external --platform=node --sourcemap --keep-names --sources-content=false src/index.ts --outfile=dist/index.js && cp package.json README.md LICENSE dist/"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.89.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
